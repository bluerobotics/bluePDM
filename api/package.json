{
  "name": "bluepdm-api",
  "version": "2.8.1",
  "description": "BluePLM REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=commonjs -e \"require('fs').copyFileSync('package.json','dist/package.json')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx server.ts",
    "dev": "tsx --watch server.ts",
    "test": "tsx test-api.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@sinclair/typebox": "^0.34.46",
    "@supabase/supabase-js": "^2.39.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
