{
  "name": "blue-plm",
  "version": "4.3.1",
  "description": "Open-source Product Lifecycle Management",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/copy-extension-host.js",
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-extension-host.js && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sw-service": "dotnet test solidworks-service/BluePLM.SolidWorksService.sln -c Release",
    "scan:divergence": "node scripts/scan-divergence.js",
    "repair:config-maps": "tsx scripts/repair-config-maps.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"electron/**/*.ts\"",
    "release": "node scripts/release.js",
    "download-restic": "node scripts/download-restic.js",
    "build-sw-service": "node scripts/build-sw-service.js",
    "cli": "node cli/blueplm.js",
    "api": "node scripts/run-api.js",
    "api:dev": "node scripts/run-api.js --watch",
    "api:build": "npm run build --prefix api",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "gen:types": "node scripts/gen-types.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@sentry/electron": "^7.5.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/jszip": "^3.4.0",
    "cfb": "^1.2.2",
    "chokidar": "^5.0.0",
    "date-fns": "^3.0.6",
    "electron-updater": "^6.7.3",
    "fastify": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.3.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "patch-package": "^8.0.1",
    "playwright": "^1.57.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.4.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.bluerobotics.plm",
    "productName": "BluePLM",
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "resources/bin/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "bluerobotics",
      "repo": "bluePLM"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "resources/bin/win32",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "solidworks-service/BluePLM.SolidWorksService/bin/Release",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/darwin-${arch}",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/linux",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  }
}
